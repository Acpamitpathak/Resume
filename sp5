CREATE PROCEDURE Sync_Stage_To_Employee
AS
BEGIN
    SET NOCOUNT ON;

    -- Step 1: Drop and recreate the temp log table
    IF OBJECT_ID('tempdb..#LogTable') IS NOT NULL
    BEGIN
        DROP TABLE #LogTable;
    END

    CREATE TABLE #LogTable (
        LogID INT IDENTITY(1,1) PRIMARY KEY,
        LogDateTime DATETIME,
        LogMessage NVARCHAR(MAX)
    );

    BEGIN TRY
        BEGIN TRANSACTION;

        INSERT INTO #LogTable (LogDateTime, LogMessage)
        VALUES (GETDATE(), 'Starting Sync_Stage_To_Employee procedure...');

        -------------------------
        -- Delete existing matching records (bulk delete)
        -------------------------
        DELETE e
        FROM employee e
        INNER JOIN stage s ON e.worker_id = s.worker_id;

        INSERT INTO #LogTable (LogDateTime, LogMessage)
        VALUES (GETDATE(), 'Deleted matching records from employee. Rows: ' + CAST(@@ROWCOUNT AS NVARCHAR));

        -------------------------
        -- Bulk Insert new records into employee
        -------------------------
        INSERT INTO employee (
            worker_id,
            emp_name,
            emp_salary,
            Status
        )
        SELECT
            s.worker_id,
            s.stage_name,
            s.stage_salary,
            'Active'
        FROM stage s
        WHERE TRY_CAST(s.worker_id AS BIGINT) NOT IN (
            SELECT worker_id FROM employee
        );

        INSERT INTO #LogTable (LogDateTime, LogMessage)
        VALUES (GETDATE(), 'Inserted new records into employee. Rows: ' + CAST(@@ROWCOUNT AS NVARCHAR));

        -------------------------
        -- Mark terminated employees
        -------------------------
        UPDATE e
        SET Status = 'Terminated'
        FROM employee e
        LEFT JOIN stage s ON s.worker_id = e.worker_id
        WHERE s.worker_id IS NULL
          AND e.Status <> 'Terminated';

        INSERT INTO #LogTable (LogDateTime, LogMessage)
        VALUES (GETDATE(), 'Marked employees as Terminated. Rows: ' + CAST(@@ROWCOUNT AS NVARCHAR));

        COMMIT;

        INSERT INTO #LogTable (LogDateTime, LogMessage)
        VALUES (GETDATE(), 'Transaction committed successfully.');
    END TRY
    BEGIN CATCH
        -- Log the error before rollback
        INSERT INTO #LogTable (LogDateTime, LogMessage)
        VALUES (GETDATE(), 'Error occurred: ' + ERROR_MESSAGE());

        IF XACT_STATE() <> 0
            ROLLBACK;

        -- Optionally return the error to caller
        RAISERROR('Transaction rolled back due to error: %s', 16, 1, ERROR_MESSAGE());
    END CATCH

    -- Final log output (optional: you can select from this temp table)
    SELECT * FROM #LogTable;
END
