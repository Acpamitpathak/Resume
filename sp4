-- Step 1: Drop the temp log table if it exists
IF OBJECT_ID('tempdb..#LogTable') IS NOT NULL
BEGIN
    DROP TABLE #LogTable;
END

-- Step 2: Create the temp log table
CREATE TABLE #LogTable (
    LogID INT IDENTITY(1,1) PRIMARY KEY,
    LogDateTime DATETIME,
    LogMessage NVARCHAR(MAX)
);

-- Step 3: Insert a log message
INSERT INTO #LogTable (LogDateTime, LogMessage)
VALUES (GETDATE(), 'Starting OUCode validation...');

-- Step 4: Capture updated employees
DECLARE @UpdatedEmployees TABLE (employee_id INT);

UPDATE e
SET 
    e.OUCode = NULL,
    e.OUValue = NULL
OUTPUT DELETED.employee_id INTO @UpdatedEmployees(employee_id)
FROM employee e
LEFT JOIN cost_center c ON e.OUCode = c.OUCode
WHERE c.OUCode IS NULL;

-- Step 5: Log for each affected employee
INSERT INTO #LogTable (LogDateTime, LogMessage)
SELECT GETDATE(), 'OUCode cleared for Employee ID: ' + CAST(employee_id AS NVARCHAR)
FROM @UpdatedEmployees;

-- Step 6: View the logs (optional)
SELECT * FROM #LogTable;


CREATE PROCEDURE Sync_Stage_To_Employee
AS
BEGIN
    SET NOCOUNT ON;

    BEGIN TRY
        -- Delete existing matching records (bulk delete)
        DELETE e
        FROM employee e
        INNER JOIN stage s ON e.worker_id = s.worker_id;

        PRINT 'Deleted records from employee table where worker_id matched with stage: ' + CAST(@@ROWCOUNT AS NVARCHAR);

        -------------------------
        -- Bulk Insert new records into employee
        -------------------------
        INSERT INTO employee (
            worker_id,
            emp_name,
            emp_salary,
            -- Add all other mapped columns
            Status
        )
        SELECT
            s.worker_id,
            s.stage_name,
            s.stage_salary,
            -- Map other columns as needed
            'Active'
        FROM stage s
        WHERE TRY_CAST(s.worker_id AS BIGINT) NOT IN (
            SELECT worker_id FROM employee
        );

        PRINT 'Bulk Inserted new records into employee table from stage. Rows inserted: ' + CAST(@@ROWCOUNT AS NVARCHAR);

        -------------------------
        -- Mark terminated employees
        -------------------------
        UPDATE e
        SET Status = 'Terminated'
        FROM employee e
        LEFT JOIN stage s ON e.worker_id = s.worker_id
        WHERE s.worker_id IS NULL
          AND e.Status <> 'Terminated';

        PRINT 'Terminated employees who are not present in stage. Rows updated: ' + CAST(@@ROWCOUNT AS NVARCHAR);

    END TRY
    BEGIN CATCH
        PRINT 'Error Occurred: ' + ERROR_MESSAGE();

        -- Optional: log to error table
        -- INSERT INTO SyncLog(ErrorMessage, ErrorDate) VALUES (ERROR_MESSAGE(), GETDATE());
    END CATCH
END
