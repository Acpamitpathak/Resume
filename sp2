CREATE PROCEDURE Sync_Stage_To_Employee
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @BatchSize INT = 2000;
    DECLARE @MinWorkerID BIGINT;
    DECLARE @MaxWorkerID BIGINT;

    BEGIN TRY
        -- Get min and max numeric worker_id values (safely casting from NVARCHAR)
        SELECT 
            @MinWorkerID = MIN(TRY_CAST(worker_id AS BIGINT)),
            @MaxWorkerID = MAX(TRY_CAST(worker_id AS BIGINT))
        FROM stage
        WHERE TRY_CAST(worker_id AS BIGINT) IS NOT NULL;

        -- Loop through in batches
        WHILE @MinWorkerID IS NOT NULL AND @MinWorkerID <= @MaxWorkerID
        BEGIN
            -------------------------
            -- Delete existing employee records for this batch (to re-insert)
            -------------------------
            DELETE e
            FROM employee e
            INNER JOIN stage s
                ON e.worker_id = s.worker_id
            WHERE 
                TRY_CAST(s.worker_id AS BIGINT) BETWEEN @MinWorkerID AND (@MinWorkerID + @BatchSize - 1);

            -------------------------
            -- Insert stage records into employee table
            -------------------------
            INSERT INTO employee (
                worker_id,
                emp_name,
                emp_salary,
                -- Add other mapped columns here...
                Status
            )
            SELECT
                s.worker_id,
                s.stage_name,
                s.stage_salary,
                -- Map remaining columns here...
                'Active'
            FROM stage s
            WHERE 
                TRY_CAST(s.worker_id AS BIGINT) BETWEEN @MinWorkerID AND (@MinWorkerID + @BatchSize - 1);

            -------------------------
            -- Mark employees not found in stage as 'Terminated'
            -------------------------
            UPDATE e
            SET Status = 'Terminated'
            FROM employee e
            LEFT JOIN stage s 
                ON s.worker_id = e.worker_id
            WHERE s.worker_id IS NULL
              AND e.Status <> 'Terminated';

            -- Move to next batch
            SET @MinWorkerID = @MinWorkerID + @BatchSize;
        END
    END TRY
    BEGIN CATCH
        PRINT 'Error Occurred: ' + ERROR_MESSAGE();
        -- Optional: log to error log table here
    END CATCH
END;
